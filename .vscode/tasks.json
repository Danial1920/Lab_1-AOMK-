{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Eco console (macOS arm64)",
      "type": "shell",
      "command": "make eco-test",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Build generated polyfit",
      "type": "shell",
      "command": "make",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Run generated unit test",
      "type": "shell",
      "command": "make test",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": ["$gcc"]
    }
  ]
}
