import "IEcoBase1.idl";

[
    object,
    uuid(93221116-2248-4742-AE06-82819447843D),
    pointer_default(unique)
]
interface IEcoCalculatorX : IEcoUnknown {
    int32_t Addition([in] int16_t a, [in] int16_t b);
    int16_t Subtraction([in] int16_t a, [in] int16_t b);
};

[
    object,
    uuid(BD6414C2-9096-423E-A90C-04D77AFD1CAD),
    pointer_default(unique)
]
interface IEcoCalculatorY : IEcoUnknown {
    int32_t Multiplication([in] int16_t a, [in] int16_t b);
    int16_t Division([in] int16_t a, [in] int16_t b);
};

[
    object,
    uuid(D3B3E2F1-8D21-4A6B-9A40-440000000052),
    pointer_default(unique)
]
interface IEcoLab1 : IEcoUnknown {
};

[
    object,
    uuid(D3B3E2F1-8D21-4A6B-9A40-440000000055),
    pointer_default(unique)
]
interface IEcoLab2 : IEcoUnknown {
    int16_t Horner([in] const int16_t* coefficients, [in] uint32_t count,
                   [in] int16_t x, [out] int32_t* result);
};

[
    object,
    uuid(D3B3E2F1-8D21-4A6B-9A40-440000000054),
    pointer_default(unique)
]
interface IEcoCalculatorSafe : IEcoUnknown {
    int16_t TryDivision([in] int16_t a, [in] int16_t b, [out] int16_t* result);
};

